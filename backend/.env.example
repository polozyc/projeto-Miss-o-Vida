# Porta em que a API vai rodar
PORT=4000

# Opção A: string de conexão única (usada por bancos gerenciados na nuvem,
# como Neon ou Supabase). Se DATABASE_URL estiver definida, ela tem prioridade
# sobre as variáveis DB_* abaixo.
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Opção B: configuração do banco de dados PostgreSQL em variáveis separadas
# (usada no docker-compose local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=missaovida
DB_PASSWORD=missaovida123
DB_NAME=missaovida_db
# DB_SSL=true   # ative se o banco separado também exigir SSL

# Segredo usado para assinar os tokens JWT (troque em produção!)
JWT_SECRET=troque_esta_chave_em_producao

# Origem permitida para requisições CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# Credenciais do administrador criado automaticamente na 1ª execução
ADMIN_DEFAULT_NAME=Administrador Missão Vida
ADMIN_DEFAULT_EMAIL=admin@missaovida.org.br
ADMIN_DEFAULT_PASSWORD=missaovida2026
