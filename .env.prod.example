# =========================================================
# Variáveis de PRODUÇÃO - copie para ".env" e preencha com
# valores reais. NUNCA versione o arquivo ".env" preenchido.
# =========================================================

# --- Banco de dados ---
POSTGRES_USER=missaovida_prod
POSTGRES_PASSWORD=GERE_UMA_SENHA_FORTE_AQUI
POSTGRES_DB=missaovida_db

# --- Segurança ---
# Gere com: openssl rand -base64 48
JWT_SECRET=GERE_UM_SEGREDO_LONGO_E_ALEATORIO_AQUI

# --- Domínios (precisam apontar via DNS para o servidor) ---
SITE_URL=https://seudominio.org.br
API_URL=https://api.seudominio.org.br/api

# --- Administrador criado na primeira execução ---
ADMIN_DEFAULT_NAME=Administrador Missão Vida
ADMIN_DEFAULT_EMAIL=admin@seudominio.org.br
ADMIN_DEFAULT_PASSWORD=GERE_UMA_SENHA_FORTE_AQUI
