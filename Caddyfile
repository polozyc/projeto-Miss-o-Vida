# Caddyfile - proxy reverso com HTTPS automático (Let's Encrypt)
#
# Troque os domínios abaixo pelos seus domínios reais, já apontando
# via DNS (registro A) para o IP do servidor antes de subir o Caddy.

seudominio.org.br {
    reverse_proxy frontend:80

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

api.seudominio.org.br {
    reverse_proxy backend:4000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }
}
